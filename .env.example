# Copie este arquivo para .env e preencha UMA das chaves.
# Sem nenhuma chave, a plataforma funciona em "modo local" (análise por regras e chat básico).

# IA gratuita (recomendado): crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# IA gratuita (alternativa): crie a chave em https://console.groq.com/keys
GROQ_API_KEY=
# Voz do Zodam (ElevenLabs, plano grátis com limite mensal): https://elevenlabs.io (Profile > API Keys)
ELEVENLABS_API_KEY=
# Opcional: voz (padrão: Brian, voz grave) e modelo (padrão: eleven_flash_v2_5, gasta metade dos créditos)
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
ELEVENLABS_MODEL=eleven_flash_v2_5

# Busca na web em tempo real (plano grátis, 1000 buscas/mês): https://tavily.com
TAVILY_API_KEY=
# Cidade padrão para perguntas de previsão sem cidade (ex.: Santa Luzia, MG)
DEFAULT_CITY=São Paulo

# IA paga (opcional)
ANTHROPIC_API_KEY=

# Opcional: força um provedor (gemini, groq ou anthropic). Padrão: o primeiro com chave, nessa ordem.
# Se tiver chaves de mais de um provedor, use AI_PROVIDER=groq para escolher o Groq.
AI_PROVIDER=
# Opcional: troca o modelo (modelos de IA são aposentados com frequência; confira a lista do provedor)
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=3000

# Asteroides (NASA). Sem chave usa DEMO_KEY (limite baixo). Chave grátis em https://api.nasa.gov
NASA_API_KEY=

# Relógio do Juízo Final: atualize todo janeiro, quando o Bulletin divulgar o novo valor
DOOMSDAY_SECONDS=85
DOOMSDAY_SET=2026-01-27

# PRIVATE URBAN INTELLIGENCE (câmeras de BH, acesso só seu). Sem esta chave o módulo fica desligado.
# Gere uma chave longa, ex.: openssl rand -base64 24
URBAN_ACCESS_KEY=
# Câmeras: cole aqui um JSON em uma linha (veja cameras.example.json) OU crie o arquivo cameras.json (só local).
URBAN_CAMERAS=
